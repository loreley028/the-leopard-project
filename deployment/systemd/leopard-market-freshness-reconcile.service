[Unit]
Description=The Leopard Project controlled Market Core freshness reconciliation
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=TZ=Asia/Shanghai
ExecStart=/opt/the-leopard-project/deployment/scripts/run_market_freshness_reconcile.sh
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/the-leopard-project
