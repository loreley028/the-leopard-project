[Unit]
Description=The Leopard Project controlled post-close daily capture
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=TZ=Asia/Shanghai
ExecStart=/opt/the-leopard-project/deployment/scripts/run_daily_market_capture.sh
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/the-leopard-project
