# Local research MVP only. Copy to an untracked .env file and replace every value.
LEOPARD_ENV=local
LEOPARD_DATA_MODE=real_local
LEOPARD_DATABASE_URL=sqlite:///var/real-local/leopard_project.sqlite3
LEOPARD_UPLOAD_DIR=var/real-local/uploads
LEOPARD_SESSION_SECRET=replace-with-at-least-32-random-characters
LEOPARD_ADMIN_USERNAME=admin
LEOPARD_ADMIN_PASSWORD=replace-me
LEOPARD_VIEWER_USERNAME=viewer
LEOPARD_VIEWER_PASSWORD=replace-me
LEOPARD_COOKIE_SECURE=false
# Daily persistence runs only through the host systemd timer after close.
LEOPARD_MARKET_AUTOMATION_ENABLED=false
# A final PDF is published only when deterministic parsing has no warning or
# blocking residue. Set false only for a deliberate recovery/review session.
LEOPARD_AUTO_PUBLISH_UPLOADS=true
