# Local research MVP only. Copy to an untracked .env file and replace every value.
LEOPARD_ENV=local
LEOPARD_DATABASE_URL=sqlite:///var/leopard_project.sqlite3
LEOPARD_UPLOAD_DIR=var/uploads
LEOPARD_SESSION_SECRET=replace-with-at-least-32-random-characters
LEOPARD_ADMIN_USERNAME=admin
LEOPARD_ADMIN_PASSWORD=replace-me
LEOPARD_VIEWER_USERNAME=viewer
LEOPARD_VIEWER_PASSWORD=replace-me
LEOPARD_COOKIE_SECURE=false
